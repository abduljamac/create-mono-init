{
  "name": "@abduljamac/create-mono-init",
  "version": "0.4.0",
  "private": false,
  "description": "CLI to scaffold a Turborepo monorepo with API, web, mobile app, and shared packages",
  "license": "MIT",
  "author": "abduljamac",
  "homepage": "https://github.com/abduljamac/create-mono-init#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abduljamac/create-mono-init.git"
  },
  "bugs": {
    "url": "https://github.com/abduljamac/create-mono-init/issues"
  },
  "keywords": [
    "cli",
    "scaffold",
    "monorepo",
    "turborepo",
    "create"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.9.0",
  "bin": {
    "create-mono-init": "dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --onSuccess \"node dist/index.js\"",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "pnpm check && pnpm typecheck && pnpm test && pnpm build",
    "smoke": "pnpm build && node scripts/smoke-package.mjs",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "release:check": "pnpm validate && node scripts/verify-package.mjs",
    "prepublishOnly": "pnpm release:check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "execa": "^10.2.1",
    "fs-extra": "^11.4.1",
    "picocolors": "^1.1.1"
  }
}
